# ── Aquila Home Tech Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.

# Flask core
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Database (SQLite for development)
DATABASE_URL=sqlite:///aquila.db
# DATABASE_URL=postgresql://user:password@localhost:5432/aquila_home_tech

# Admin seed credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@aquilahometech.com
ADMIN_PASSWORD=change-this-password

# Business contact
WHATSAPP_NUMBER=2348105208988
BUSINESS_PHONE=+234 704 792 7308
BUSINESS_EMAIL=info@aquilahometech.com
BUSINESS_ADDRESS=12 Electronics Road, GRA, Ilorin, Kwara State, Nigeria

# Upload settings
MAX_CONTENT_LENGTH=5242880
UPLOAD_FOLDER=app/static/images/uploads